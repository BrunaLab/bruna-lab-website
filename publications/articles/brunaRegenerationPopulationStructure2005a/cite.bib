  author = {Emilio M. Bruna" and "Maria Beatriz Nogueira Ribeiro},
  month = {jan},
  year = {2005},
  pages = {127-131},
  publisher = {CAMBRIDGE UNIV PRESS},
  keywords = {Heliconiaceae, seed germination, edge effects, Cecropia, dispersal limitation, forest regeneration, population structure, Vismia},
}
