  rowid = { 79},
  title = {Landscape Quality Drives Ecological Responses to Habitat Loss and Fragmentation},
  author = {Robert J. Fletcher and Thomas A. H. Smith and Maggie Jones and Fredericke Schellenberg and Rikki Payne and Nicholas Kortessis and Emilio M. Bruna and Robert D. Holt},
